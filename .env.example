# Otopark Demo — ayarlar
# Bu dosya .env olarak kopyalanır (başlatıcı ilk açılışta otomatik yapar).

# Kamera veya video kaynağı.
# Gerçek kamera:  rtsp://kullanici:sifre@192.168.1.50:554/...
# Deneme videosu: veri/ornek-otopark.mp4  (proje klasörüne göre yol)
KAYNAK=veri/ornek-otopark.mp4

# Saniyede kaç kare analiz edilsin (2-6 arası yeterli)
KARE_FPS=3

# Tespit modeli (models/indir.sh ile inen dosya)
MODEL_DOSYASI=models/yolox_tiny.onnx

# Analiz cihazı: cpu | cuda
CIHAZ=cpu
