# Otopark Demo — ayarlar
# Bu dosya .env olarak kopyalanır (başlatıcı ilk açılışta otomatik yapar).

# Kamera veya video kaynağı.
# Gerçek kamera:  rtsp://kullanici:sifre@192.168.1.50:554/...
# Deneme videosu: veri/ornek-otopark.mp4  (proje klasörüne göre yol)
KAYNAK=veri/ornek-otopark.mp4

# Saniyede kaç kare analiz edilsin (2-6 arası yeterli)
KARE_FPS=3

# Tespit modeli — NextGen AI
# MODEL_DOSYASI boş bırakılırsa kurulu kademelerin en isabetlisi otomatik seçilir
# (NextGen AI İsabetli kuruluysa o, değilse NextGen AI Hızlı).
# Elle bir model seçmek isterseniz models/ klasöründeki dosyanın yolunu yazın.
MODEL_DOSYASI=

# Analiz cihazı: cpu | cuda
CIHAZ=cpu

# Panel şifresi: boş bırakılırsa giriş istenmez; doldurulursa panel şifreyle açılır
PANEL_SIFRESI=
